rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'admin@sapa.edu.vn'
      );
    }

    function isTeacher() {
      return isSignedIn() && (
        isAdmin() ||
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isTeacher();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role != 'admin';
      allow update: if isOwner(userId) && (
        // Forbid self-elevation to admin or teacher
        request.resource.data.role == resource.data.role &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatar', 'updatedAt'])
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Teachers Collection
    match /teachers/{teacherId} {
      allow read: if isTeacher();
      allow write: if isAdmin();
    }

    // Students Collection: Strict isolation - students can ONLY access their own profile!
    match /students/{studentId} {
      allow get: if isOwner(studentId) || isTeacher();
      allow list: if isTeacher();
      allow create: if isTeacher();
      allow update: if (isOwner(studentId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['greenPoints', 'badges', 'sortGamesPlayed', 'quizzesCompleted'])) || isTeacher();
      allow delete: if isAdmin();

      // Private Subcollection: Green Action Diary entries
      match /actions/{actionId} {
        allow get: if isOwner(studentId) || isTeacher();
        allow list: if isOwner(studentId) || isTeacher();
        allow create: if isOwner(studentId) || isTeacher();
        allow update: if isTeacher();
        allow delete: if isOwner(studentId) || isTeacher();
      }

      // Private Subcollection: Quizzes
      match /quizzes/{quizId} {
        allow get: if isOwner(studentId) || isTeacher();
        allow list: if isOwner(studentId) || isTeacher();
        allow create: if isOwner(studentId);
        allow update, delete: if isTeacher();
      }
    }

    // Classes Collection
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
